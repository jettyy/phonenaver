# ── Claude (내 구독 계정 Pro/Max 사용, API 키 필요 없음) ──────────
# 이 컴퓨터에 Claude Code 를 설치하고 `claude` 를 한 번 실행해 구독 계정으로 로그인하면 끝.
# 화면 없는 서버라면 PC에서 `claude setup-token` 으로 받은 토큰을 아래에 넣기
CLAUDE_CODE_OAUTH_TOKEN=
# 비우면 계정 기본 모델. opus / sonnet 처럼 지정 가능
CLAUDE_MODEL=
# claude 실행 파일 경로 (보통 비워둠)
CLAUDE_BIN=
# 글 하나당 웹 검색 최대 횟수
MAX_SEARCHES=5

# ── 텔레그램 봇 (휴대폰 지시용) ─────────────────────────
# @BotFather 에서 봇을 만들고 받은 토큰
TELEGRAM_BOT_TOKEN=
# 명령을 받을 채팅 ID (쉼표로 여러 개). 비워두고 봇에 /id 를 보내면 알려줌
ALLOWED_CHAT_IDS=

# ── 네이버 블로그 ─────────────────────────────────────
# 블로그 주소 blog.naver.com/<여기> 부분
NAVER_BLOG_ID=
# 네이버 아이디/비밀번호: 로그인이 풀리면 자동으로 다시 로그인 (비우면 직접 로그인한 세션만 사용)
NAVER_ID=
NAVER_PW=
# 브라우저 창을 숨길지 (서버: true / 처음 테스트할 때: false 추천)
HEADLESS=true
# 로그인 세션이 저장되는 폴더
BROWSER_PROFILE_DIR=data/browser
# 크롬 실행 파일을 직접 지정할 때만 (보통 비워둠)
BROWSER_EXECUTABLE=

# ── 글 스타일 ─────────────────────────────────────────
# 조사한 출처 링크를 글 끝에 '참고 자료'로 붙일지
INCLUDE_SOURCES=false
# 해시태그를 본문 맨 끝에 붙일지
APPEND_HASHTAGS=true

# ── 이미지 ────────────────────────────────────────────
# 글마다 넣을 이미지 수. 우선순위: 텔레그램으로 보낸 내 사진 → Pexels 무료 사진 → 자동 생성 카드 이미지
IMAGE_COUNT=3
# 첫 번째 이미지를 제목이 들어간 썸네일 카드로 만들지 (내 사진을 보냈으면 내 사진 우선)
THUMBNAIL_CARD=true
# https://www.pexels.com/api/ 에서 무료 발급. 비우면 사진 대신 카드 이미지로 채움
PEXELS_API_KEY=
# 카드 이미지용 한글 폰트 경로 (비우면 자동 탐색, 없으면 나눔고딕 자동 다운로드)
FONT_PATH=

# ── 카테고리 ──────────────────────────────────────────
# 글 내용에 맞는 카테고리를 자동 선택
AUTO_CATEGORY=true
# 카테고리 목록을 직접 적을 때만 (쉼표 구분). 비우면 내 블로그에서 자동으로 불러옴
NAVER_CATEGORIES=
