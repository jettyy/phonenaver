# ── Claude (내 구독 계정 Pro/Max 사용, API 키 필요 없음) ──────────
# 이 컴퓨터에 Claude Code 를 설치하고 `claude` 를 한 번 실행해 구독 계정으로 로그인하면 끝.
# 화면 없는 서버라면 PC에서 `claude setup-token` 으로 받은 토큰을 아래에 넣기
CLAUDE_CODE_OAUTH_TOKEN=
# 글쓰기 모델은 sonnet 으로 고정되어 있습니다 (바꿀 수 없음)
# claude 실행 파일 경로 (보통 비워둠)
CLAUDE_BIN=
# 글 하나당 웹 검색 최대 횟수
MAX_SEARCHES=5

# ── 텔레그램 봇 (휴대폰 지시용) ─────────────────────────
# 대시보드 3번 칸에서 넣으면 자동으로 저장됩니다
TELEGRAM_BOT_TOKEN=
ALLOWED_CHAT_IDS=

# ── 네이버 블로그 ─────────────────────────────────────
# 블로그 주소 blog.naver.com/<여기> 부분 (대시보드에서 네이버 로그인하면 자동으로 채워짐)
# 로그인은 대시보드의 [네이버 로그인 창 열기] 에서 직접 한 번만 합니다. 비밀번호는 저장하지 않습니다.
NAVER_BLOG_ID=
# 글 쓸 때 브라우저 창을 숨길지 (처음에는 false 로 두고 글 쓰는 모습을 확인해 보세요)
HEADLESS=true
# 로그인 세션이 저장되는 폴더
BROWSER_PROFILE_DIR=data/browser
# 크롬 실행 파일을 직접 지정할 때만 (보통 비워둠)
BROWSER_EXECUTABLE=

# ── 글 스타일 ─────────────────────────────────────────
# 조사한 출처 링크를 글 끝에 '참고 자료'로 붙일지
INCLUDE_SOURCES=false
# 해시태그를 본문 맨 끝에 붙일지
APPEND_HASHTAGS=true

# ── 이미지 ────────────────────────────────────────────
# 문단(소제목) 사이마다 사진 넣기 (도입부 뒤 1장 + 소제목마다 1장). 채우는 순서: Pexels 무료 사진 → 카드 이미지
IMAGE_PER_SECTION=true
# 위 방식일 때 최대 장수
MAX_IMAGES=8
# IMAGE_PER_SECTION=false 일 때 글마다 넣을 이미지 수
IMAGE_COUNT=3
# 문단 사이 빈 줄 수 (가독성)
PARAGRAPH_GAP=2
# 글 품질 — 최소 분량(공백 제외 글자 수). 모자라면 다시 쓰게 함
MIN_CHARS=1500
# 모든 글에 순위표(1위부터) 넣기, 순위표 최소 줄 수
ALWAYS_RANKING=true
RANKING_MIN=10
# 링크·유튜브로 쓰는 글도 최신 정보를 검색해서 내용 보강
ALWAYS_RESEARCH=true
# 저장 방식: draft = 임시저장만(기본), schedule = 임시저장해 두고 정해진 시각에 발행
PUBLISH_MODE=draft
# 발행 시각: 시작 시각(HH:MM, 비우면 임시저장 직후부터), 발행 글 사이 간격(분), 발행마다 더할 랜덤 대기(0~N분)
PUBLISH_AT=
PUBLISH_INTERVAL=60
PUBLISH_RANDOM=30
# 발행 안 하는 시간대 (예: 01:00 ~ 07:00). 이 시간에는 글은 계속 임시저장하고, 발행만 이 시간이 끝난 뒤로 미룸. 비우면 끔
NO_PUBLISH_START=
NO_PUBLISH_END=
# 글을 연달아 저장할 때 글 사이에 쉬는 시간(초). 네이버 어뷰징 판정 방지. 0 이면 안 쉼
POST_DELAY_MIN=30
POST_DELAY_MAX=90
# 첫 번째 이미지를 제목이 들어간 썸네일 카드로 만들지 (내 사진을 보냈으면 내 사진 우선)
THUMBNAIL_CARD=true
# https://www.pexels.com/api/ 에서 무료 발급. 비우면 사진 대신 카드 이미지로 채움
PEXELS_API_KEY=
# 카드 이미지용 한글 폰트 경로 (비우면 자동 탐색, 없으면 나눔고딕 자동 다운로드)
FONT_PATH=

# ── 카테고리 ──────────────────────────────────────────
# 글 내용에 맞는 카테고리를 자동 선택
AUTO_CATEGORY=true
# 카테고리 목록을 직접 적을 때만 (쉼표 구분). 비우면 내 블로그에서 자동으로 불러옴
NAVER_CATEGORIES=

# 대시보드 주소 포트 (기본 3100 → http://localhost:3100)
PORT=
