# ── Claude API ─────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-opus-5
# 안전 분류기가 거절하면 서버에서 다른 모델로 자동 재시도 (true/false)
CLAUDE_FALLBACK=true
# 글 하나당 웹 검색 최대 횟수
MAX_SEARCHES=5

# ── 텔레그램 봇 (휴대폰 지시용) ─────────────────────────
# @BotFather 에서 봇을 만들고 받은 토큰
TELEGRAM_BOT_TOKEN=
# 명령을 받을 채팅 ID (쉼표로 여러 개). 비워두고 봇에 /id 를 보내면 알려줌
ALLOWED_CHAT_IDS=

# ── 네이버 블로그 ─────────────────────────────────────
# 블로그 주소 blog.naver.com/<여기> 부분
NAVER_BLOG_ID=
# 브라우저 창을 숨길지 (서버: true / 처음 테스트할 때: false 추천)
HEADLESS=true
# 로그인 세션이 저장되는 폴더
BROWSER_PROFILE_DIR=data/browser
# 크롬 실행 파일을 직접 지정할 때만 (보통 비워둠)
BROWSER_EXECUTABLE=

# ── 글 스타일 ─────────────────────────────────────────
# 조사한 출처 링크를 글 끝에 '참고 자료'로 붙일지
INCLUDE_SOURCES=false
# 해시태그를 본문 맨 끝에 붙일지
APPEND_HASHTAGS=true
